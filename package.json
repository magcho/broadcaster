{
  "name": "broadcaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "pnpm -r type-check",
    "build:admin": "VERCEL=1 pnpm -F broadcaster-admin build",
    "start:admin": "pnpm -F broadcaster-admin start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "fix": "pnpm run /.+:fix/"
  },
  "devDependencies": {
    "emulate": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vercel": "catalog:"
  },
  "volta": {
    "node": "24.11.0"
  },
  "packageManager": "pnpm@11.23.0"
}
